# .env_example
# 项目配置模板文件。开发者克隆项目后将此文件重命名为 `.env` ，并填写真实的配置值。

# --- 项目基础信息 ---
PROJECT_NAME="DocClassify-OCR-DL"

# --- Redis & Celery 配置 ---
# 例如：redis://:your_password@your_public_ip:6379/1
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"

# --- 文件上传规则微调 ---
MAX_IMAGE_SIZE_MB=10
MAX_PDF_SIZE_MB=200
